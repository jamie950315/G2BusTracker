[Unit]
Description=Taiwan Bus G2 realtime data proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jamie
Group=jamie
WorkingDirectory=/opt/taiwan-bus-g2-proxy
Environment=HOST=127.0.0.1
Environment=PORT=8893
ExecStart=/usr/bin/node /opt/taiwan-bus-g2-proxy/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
